{
  "name": "pi-ruleset",
  "version": "0.4.0",
  "description": "Store and apply business rules as structured per-day Markdown files with BM25 search",
  "keywords": [
    "pi-package"
  ],
  "author": "uaniay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uaniay/plugins.git",
    "directory": "packages/pi-ruleset"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "pg": "^8.16.3",
    "wink-bm25-text-search": "^3.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "extensions/",
    "skills/",
    "prompts/",
    "migrations/",
    "rules/references/",
    "rules/RULES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.cjs"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
